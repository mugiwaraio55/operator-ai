# Browser-safe values from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Edge Function secrets — set these in Supabase, never expose them with NEXT_PUBLIC_.
# APP_ORIGIN must exactly match the app URL, with no trailing slash.
APP_ORIGIN=http://localhost:3000
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v24.0

# Optional: without this key, the assistants use built-in, rules-based briefs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GLM_API_KEY=

# Optional shared fallback for custom trusted webhook senders. The app-generated
# tokenized GHL/Fathom URLs do not need these values.
WEBHOOK_SECRET=
